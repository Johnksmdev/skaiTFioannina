# Database — Prisma Postgres (recommended) or Vercel Postgres
# Prisma Postgres: copy from console.prisma.io → your project → "Connection string"
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
DATABASE_URL_DIRECT="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"